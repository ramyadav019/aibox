{
  "version": 2,
  "outputDirectory": "Chatbot/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/chat",
      "destination": "/api/index.py"
    },
    {
      "source": "/conversation",
      "destination": "/api/index.py"
    },
    {
      "source": "/conversation/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
