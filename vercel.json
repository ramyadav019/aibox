{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "chatbot": {
      "root": "Chatbot",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/chat",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/conversation",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/conversation/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "chatbot"
      }
    }
  ]
}
