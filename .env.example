# LLM API credentials (provide either Gemini or OpenAI credentials)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-pro

# Alternatively, standard OpenAI credentials:
# OPENAI_API_KEY=your_openai_api_key_here

# Persistent database (Neon Serverless PostgreSQL connection string)
NEON_DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Frontend: Base URL for backend (leave blank if deploying full-stack on the same Vercel project)
# VITE_API_BASE=https://my-backend-domain.vercel.app
